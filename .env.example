# Copy to .env. Never commit .env.

# Vapi dashboard key. The app runs without it; scripts/create_assistant.py exits
# with an error until this is set.
VAPI_API_KEY=

# Inbound number to attach the assistant to (PATCH assistantId).
VAPI_PHONE_NUMBER_ID=

# Public HTTPS origin Vapi can reach. ngrok free static domain:
#   ngrok http --url=<name>.ngrok-free.app 8000
PUBLIC_BASE_URL=https://your-name.ngrok-free.app

# Random token embedded in the webhook path: /vapi/webhook/<token>
WEBHOOK_TOKEN=replace-with-a-long-random-string

# Shown on /start. The hackathon number.
PHONE_DISPLAY=+1 858-348-9143

# replay  — start the helicopter track when a call connects
# (empty) — arm replay only from the dashboard (POST /api/replay/start)
DEMO_MODE=

# Pin a simulated fix, "lat,lon". Phone updates replace it until you pick a spot.
DEMO_LOCATION=

# 1 to apply demo/tfr.json (a fake TFR polygon). Off by default.
DEMO_TFR=

# 1 to skip outbound airspace fetches and use data/cache only.
FREQ_OFFLINE=
